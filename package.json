{
  "name": "mcp-guard",
  "version": "1.2.0",
  "description": "Zero-dependency static security analyzer, prompt-injection firewall, and context-window token profiler for Model Context Protocol (MCP) servers.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-guard": "./bin/mcp-guard.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "prompt-injection",
    "token-profiler",
    "claude",
    "llm-security",
    "static-analysis"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/utils/mcpAnalyzer.test.ts",
    "audit:example": "node bin/mcp-guard.mjs audit examples/vulnerable.mcp.json",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
